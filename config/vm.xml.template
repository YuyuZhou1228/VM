<!--
  libvirt domain template for a bare-metal-fidelity Windows 11 guest.

  Placeholders like ${VM_NAME} are filled in by scripts/02-build-vm.sh (envsubst).
  The SMBIOS/<sysinfo> identity block is intentionally left as editable literals
  so you can tune it to resemble a real OEM machine — see docs/FIDELITY.md.
-->
<domain type='kvm' xmlns:qemu='http://libvirt.org/schemas/domain/qemu/1.0'>
  <name>${VM_NAME}</name>
  <uuid>${VM_UUID}</uuid>

  <metadata>
    <libosinfo:libosinfo xmlns:libosinfo="http://libosinfo.org/xmlns/libvirt/domain/1.0">
      <libosinfo:os id="http://microsoft.com/win/11"/>
    </libosinfo:libosinfo>
  </metadata>

  <memory unit='MiB'>${MEM_MIB}</memory>
  <currentMemory unit='MiB'>${MEM_MIB}</currentMemory>
  <vcpu placement='static'>${VCPUS}</vcpu>

  <os firmware='efi'>
    <type arch='x86_64' machine='${MACHINE_TYPE}'>hvm</type>
    <loader secure='yes'/>
    <nvram/>
    <!-- Boot from CD first so the installer runs on a blank disk; eject the
         ISOs after install (scripts/03-detach-install-media.sh) to boot the OS. -->
    <boot dev='cdrom'/>
    <boot dev='hd'/>
    <bootmenu enable='yes' timeout='3000'/>
    <!-- Populate SMBIOS tables from the <sysinfo> block below. -->
    <smbios mode='sysinfo'/>
  </os>

  <features>
    <acpi/>
    <apic/>
    <!-- Hyper-V enlightenments: let Windows schedule, time, and idle
         efficiently under KVM. Big performance/stability win. See FIDELITY.md
         for the trade-off (these advertise a Hyper-V interface to the guest). -->
    <hyperv mode='custom'>
      <relaxed state='on'/>
      <vapic state='on'/>
      <spinlocks state='on' retries='8191'/>
      <vpindex state='on'/>
      <runtime state='on'/>
      <synic state='on'/>
      <stimer state='on'><direct state='on'/></stimer>
      <reset state='on'/>
      <frequencies state='on'/>
      <tlbflush state='on'/>
      <ipi state='on'/>
      <vendor_id state='on' value='GenuineIntel'/>
    </hyperv>
    <!-- Hide the KVM paravirtual CPUID leaf. Standard setting so that real
         GPU drivers behave normally once you move to GPU passthrough. -->
    <kvm>
      <hidden state='on'/>
    </kvm>
    <vmport state='off'/>
    <smm state='on'/>
  </features>

  ${CPU_DEF}

  <clock offset='localtime'>
    <timer name='rtc' tickpolicy='catchup'/>
    <timer name='pit' tickpolicy='delay'/>
    <timer name='hpet' present='no'/>
    <timer name='hypervclock' present='yes'/>
  </clock>

  <on_poweroff>destroy</on_poweroff>
  <on_reboot>restart</on_reboot>
  <on_crash>destroy</on_crash>

  <pm>
    <suspend-to-mem enabled='no'/>
    <suspend-to-disk enabled='no'/>
  </pm>

  <!-- ======================================================================
       SMBIOS / DMI identity — what `systeminfo`, `wmic baseboard`, and Device
       Manager report. Edit to match a real OEM system for best fidelity; keep
       the vendor + product line internally consistent. See docs/FIDELITY.md.
       =================================================================== -->
  <sysinfo type='smbios'>
    <bios>
      <entry name='vendor'>American Megatrends Inc.</entry>
      <entry name='version'>2423</entry>
      <entry name='date'>08/18/2023</entry>
      <entry name='release'>5.27</entry>
    </bios>
    <system>
      <entry name='manufacturer'>ASUS</entry>
      <entry name='product'>System Product Name</entry>
      <entry name='version'>1.0</entry>
      <entry name='serial'>${SYS_SERIAL}</entry>
      <entry name='uuid'>${VM_UUID}</entry>
      <entry name='sku'>SKU0001</entry>
      <entry name='family'>ASUS MB</entry>
    </system>
    <baseboard>
      <entry name='manufacturer'>ASUSTeK COMPUTER INC.</entry>
      <entry name='product'>PRIME B660-PLUS D4</entry>
      <entry name='version'>Rev 1.xx</entry>
      <entry name='serial'>${BOARD_SERIAL}</entry>
      <entry name='asset'>Default string</entry>
      <entry name='location'>Default string</entry>
    </baseboard>
    <chassis>
      <entry name='manufacturer'>Default string</entry>
      <entry name='version'>Default string</entry>
      <entry name='serial'>${CHASSIS_SERIAL}</entry>
      <entry name='asset'>Default string</entry>
      <entry name='sku'>Default string</entry>
    </chassis>
    <oemStrings>
      <entry>Default string</entry>
    </oemStrings>
  </sysinfo>

  <devices>
    <emulator>/usr/bin/qemu-system-x86_64</emulator>

    <!-- Primary disk as a SATA drive: reads like a real SSD/HDD and Windows
         has in-box drivers, so no virtio needed during install.
         The drive's *model* string still defaults to "QEMU HARDDISK" (an
         obvious tell in `wmic diskdrive get model`); libvirt can't set it, so
         the <qemu:override> at the bottom of this file rewrites it via the
         ide-hd `model`/`ver` properties. The user alias `ua-disk-primary` is
         what that override targets. -->
    <disk type='file' device='disk'>
      <driver name='qemu' type='qcow2' cache='none' io='native' discard='unmap'/>
      <source file='${DISK_PATH}'/>
      <target dev='sda' bus='sata'/>
      <serial>${DISK_SERIAL}</serial>
      <alias name='ua-disk-primary'/>
      <address type='drive' controller='0' bus='0' target='0' unit='0'/>
    </disk>

    <!-- Windows install ISO (eject after install). -->
    <disk type='file' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <source file='${INSTALL_ISO}'/>
      <target dev='sdb' bus='sata'/>
      <readonly/>
      <address type='drive' controller='0' bus='0' target='0' unit='1'/>
    </disk>

    <!-- Unattended answer ISO: autounattend.xml lives at its root. -->
    <disk type='file' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <source file='${ANSWER_ISO}'/>
      <target dev='sdc' bus='sata'/>
      <readonly/>
      <address type='drive' controller='0' bus='0' target='0' unit='2'/>
    </disk>

    <!-- virtio-win ISO: QEMU guest agent + optional paravirtual drivers. -->
    <disk type='file' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <source file='${VIRTIO_ISO}'/>
      <target dev='sdd' bus='sata'/>
      <readonly/>
      <address type='drive' controller='0' bus='0' target='0' unit='3'/>
    </disk>

    <controller type='sata' index='0'/>
    <controller type='usb' model='qemu-xhci' ports='15'/>
    <controller type='pci' model='pcie-root'/>
    <controller type='pci' model='pcie-root-port'/>
    <controller type='pci' model='pcie-root-port'/>
    <controller type='pci' model='pcie-root-port'/>
    <controller type='pci' model='pcie-root-port'/>

    <!-- Intel Gigabit NIC (e1000e): in-box Windows driver, reads as real
         hardware. MAC uses a real-vendor OUI (set in scripts/lib.sh). -->
    <interface type='network'>
      <source network='default'/>
      <mac address='${MAC_ADDR}'/>
      <model type='e1000e'/>
    </interface>

    <!-- Emulated display for install/dev. Swap for GPU passthrough later for
         the most bare-metal feel (hardware-specific, not portable). -->
    <video>
      <model type='vga' vram='65536' heads='1'/>
    </video>
    <graphics type='spice' autoport='yes'>
      <listen type='address'/>
      <image compression='off'/>
    </graphics>

    <!-- No USB tablet: it enumerates as "QEMU USB Tablet" (idVendor 0x0627),
         a clear tell in Device Manager. PS/2 keyboard + mouse read as the
         ordinary built-in input of a real desktop. (Trade-off: without the
         tablet, SPICE absolute-pointer sync is lost and the console pointer
         can feel laggy/relative — fine for a real workload, mildly annoying
         for console-only use. Re-add the tablet if that bothers you.) -->
    <input type='keyboard' bus='ps2'/>
    <input type='mouse' bus='ps2'/>

    <!-- Intel High Definition Audio (ich9-intel-hda): a real desktop has an
         audio controller. Its absence is a small but real "this box is bare"
         signal, and Windows has an in-box HDA driver so it needs no extra
         install. -->
    <sound model='ich9'/>

    <!-- TPM 2.0 (swtpm) — required by Windows 11. -->
    <tpm model='tpm-crb'>
      <backend type='emulator' version='2.0'/>
    </tpm>

    <!-- No virtio-rng: it enumerates as a Red Hat VirtIO RNG (PCI vendor
         1AF4) — a paravirtual tell, and without the driver it shows as an
         unknown PCI device with a warning icon. Real machines don't have one. -->

    <!-- No memballoon: the balloon is a virtual-only device and buys little here. -->
    <memballoon model='none'/>

    <!-- No spicevmc channel: com.redhat.spice.0 is a virtio-serial port
         (Red Hat vendor) for the SPICE guest agent, which isn't installed
         anyway. Dropping it removes one more paravirtual device. SPICE display
         still works for the console. -->
  </devices>

  <!-- ======================================================================
       QEMU-level overrides for tells libvirt can't express natively.
       Requires the qemu:// namespace (declared on <domain> above).

       1. <qemu:commandline> appends raw QEMU args AFTER the ones libvirt
          generates, so they win on any option that is "last one wins":
            * -machine x-oem-id / x-oem-table-id — rewrites the ACPI table OEM
              fields, which otherwise default to "BOCHS "/"BXPC" (a textbook
              VM signature, e.g. HKLM\HARDWARE\ACPI\DSDT\BOCHS_). Max 6 and 8
              chars respectively. Multiple -machine args merge in QEMU.
            * -smbios type=0,uefi=on,vm=off — clears the SMBIOS "system is a
              virtual machine" BIOS-characteristics bit (dmidecode: "System is
              a virtual machine"), which QEMU sets by default. It MUST repeat
              uefi=on, because QEMU re-reads both flags on every type=0 entry
              and this (last) entry would otherwise reset uefi to off. The
              vendor/version/date set by libvirt's earlier -smbios are kept
              (QEMU only overwrites fields that are present).

       2. <qemu:override> injects frontend device properties into libvirt's
          own -device line (needs libvirt >= 8.2, i.e. Ubuntu 24.04+; on older
          libvirt this block is ignored/ rejected — drop it there and accept
          the default disk model). It sets the ide-hd `model`/`ver` so the
          disk reports as a real SSD instead of "QEMU HARDDISK".
       =================================================================== -->
  <qemu:commandline>
    <qemu:arg value='-machine'/>
    <qemu:arg value='x-oem-id=ALASKA,x-oem-table-id=A M I'/>
    <qemu:arg value='-smbios'/>
    <qemu:arg value='type=0,uefi=on,vm=off'/>
  </qemu:commandline>

  <qemu:override>
    <qemu:device alias='ua-disk-primary'>
      <qemu:frontend>
        <qemu:property name='model' type='string' value='Samsung SSD 870 EVO 500GB'/>
        <qemu:property name='ver' type='string' value='SVQ01B6Q'/>
      </qemu:frontend>
    </qemu:device>
  </qemu:override>
</domain>
