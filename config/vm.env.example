# =============================================================================
# vm.env  —  configuration for the bare-metal-fidelity Windows VM
# -----------------------------------------------------------------------------
# Copy this file to config/vm.env and edit the values. config/vm.env is
# git-ignored so your machine-specific paths never get committed.
#
#   cp config/vm.env.example config/vm.env
#
# Every script sources config/vm.env, so this one file drives the whole build.
# =============================================================================

# --- Identity ---------------------------------------------------------------
# The libvirt domain name. Also used to name the disk image and nvram file.
VM_NAME="win11-bm"

# --- Sizing -----------------------------------------------------------------
RAM_GB=8          # Guest RAM in GiB. Keep well under host RAM.
DISK_GB=80        # Virtual disk size in GiB (qcow2 grows on demand).

# CPU topology. Total vCPUs = SOCKETS * CORES * THREADS.
# Keep total vCPUs <= host physical threads. 1/4/1 = 4 vCPUs is a safe default.
CPU_SOCKETS=1
CPU_CORES=4
CPU_THREADS=1

# CPU presentation mode:
#   host-passthrough  -> most faithful, best perf, but tied to THIS host's CPU
#                        (may trigger issues when ported to a different CPU).
#   custom            -> use CPU_MODEL below; portable across matching vendors.
# See docs/PORTABILITY.md for how to pick a model that works on both machines.
CPU_MODE="host-passthrough"
CPU_MODEL="Haswell-noTSX-IBRS"   # only used when CPU_MODE="custom" (Intel example)

# --- Machine type -----------------------------------------------------------
# Pin a Q35 machine type that BOTH of your machines' QEMU versions support.
# Leave as "q35" to let libvirt pick the newest; pin an explicit version
# (e.g. "pc-q35-8.2") once you know what both machines have. See PORTABILITY.md.
MACHINE_TYPE="q35"

# --- Install media ----------------------------------------------------------
# ISO_SOURCE:
#   quickget -> auto-download the official Microsoft Windows 11 retail ISO.
#               Installs UNACTIVATED (works forever, has a desktop watermark).
#   manual   -> you provide the ISO yourself at INSTALL_ISO below. Use this for
#               a Windows 11 Enterprise *Evaluation* ISO (clean, 90 days) which
#               must be downloaded by hand from Microsoft's Evaluation Center.
ISO_SOURCE="quickget"

# Absolute path to the Windows install ISO.
# - ISO_SOURCE=quickget: this is where the download is placed (auto-filled).
# - ISO_SOURCE=manual:   set this to the ISO you downloaded.
INSTALL_ISO="${HOME}/vm-media/windows11.iso"

# virtio-win ISO (paravirtual drivers + QEMU guest agent). Auto-downloaded.
VIRTIO_ISO="${HOME}/vm-media/virtio-win.iso"

# --- Windows unattended-install answers -------------------------------------
# These populate unattended/autounattend.xml so Setup runs with no clicks.
WIN_EDITION="Windows 11 Pro"   # must match an edition present in the ISO
WIN_USERNAME="user"
WIN_PASSWORD="changeme"        # local admin password; change this
WIN_HOSTNAME="DESKTOP-7K2P9A"  # computer name as seen on the network
WIN_LOCALE="en-US"
WIN_TIMEZONE="UTC"             # e.g. "Pacific Standard Time", "GMT Standard Time"

# --- Storage layout ---------------------------------------------------------
# Where the VM's files live on the host. The disk image and per-VM nvram go here.
VM_DIR="${HOME}/vm-store/${VM_NAME}"

# --- Networking -------------------------------------------------------------
# MAC address presented to the guest. Leave blank to auto-generate a stable one
# using a real-vendor OUI (see scripts/lib.sh). A stable MAC keeps Windows from
# treating the NIC as "new hardware" after a rebuild.
MAC_ADDR=""
